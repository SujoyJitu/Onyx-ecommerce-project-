        ],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "Get me with token (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns the current user', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('customerEmail'));",
              "});"
