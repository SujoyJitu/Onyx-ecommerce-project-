{
  "info": {
    "_postman_id": "6f7f0f66-e890-47bf-9fd8-913a8771f905",
    "name": "Onyx Auth API",
    "description": "Local auth flow checks. Development auth links are returned only when SMTP is not configured and NODE_ENV is not production.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "customerEmail",
      "value": ""
    },
    {
      "key": "vendorEmail",
      "value": ""
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "vendorVerificationToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register customer (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('customerEmail', `customer-${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('creates a customer without exposing password', () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.user.role).to.eql('customer');",
              "  pm.expect(body.user).not.to.have.property('password');",
              "  pm.expect(body.developmentVerificationUrl).to.be.a('string');",
              "  pm.collectionVariables.set('verificationToken', body.developmentVerificationUrl.match(/[?&]token=([a-f0-9]{64})/)[1]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"phone\": \"+15555550101\",\n  \"password\": \"TestPass123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Register duplicate email (resend, 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('resends verification for a duplicate unverified email', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.collectionVariables.set('verificationToken', pm.response.json().developmentVerificationUrl.match(/[?&]token=([a-f0-9]{64})/)[1]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"phone\": \"+15555550101\",\n  \"password\": \"TestPass123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Register invalid input (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns field validation errors', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"A\",\n  \"email\": \"not-an-email\",\n  \"phone\": \"1\",\n  \"password\": \"short\",\n  \"role\": \"admin\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Verify customer email (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('verifies email and issues a session token', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.collectionVariables.set('token', pm.response.json().token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/verify-email"
